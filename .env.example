# --- Required for live data --------------------------------------------------
# Hackathon key from the Qloo Agentic Hackathon developer guide. Hackathon keys
# only work against the hackathon host below.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# --- Language model (optional, strongly recommended) --------------------------
# Without it Meets still works: touchstones are required and copy comes from
# evidence-only templates. With it, the agent reads loglines, writes the pitch
# copy, interprets refinements and runs the gut check.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=medium

# --- Server -------------------------------------------------------------------
PORT=8080
# Public origin, used in MCP answers and Markdown exports.
PUBLIC_URL=https://your-app.example.com
DATA_DIR=data
WEB_DIR=../app/build/web
EXAMPLES_DIR=examples
# QLOO_MODE=live | preview | off   (preview = labelled sample data for UI work; never for a public demo)
# QLOO_MODE=live

# --- Budget guards for a public demo on a shared key (5 rps, 10k/month) --------
RUNS_PER_HOUR_PER_IP=20
RUNS_PER_DAY=400
MAX_CONCURRENT_RUNS=4
QLOO_MIN_INTERVAL_MS=260
# Reverse proxies that append to X-Forwarded-For (used for per-IP limits).
# 1 for Render and most hosts; 2 for Google Cloud Run. Fly.io uses Fly-Client-IP.
TRUSTED_PROXY_HOPS=1
